## GlyphHub example environment file (copy to .env.local)

# Firebase Web SDK config (from Firebase console → Project settings → General → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: enable Google Analytics for web
# (If unset, analytics remains disabled gracefully.)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Replicate (server-side only)
# Required for /api/chat streaming proxy
REPLICATE_API_TOKEN=

# Replicate curated collections (CSV). Used by /api/models
REPLICATE_COLLECTION_SLUGS=text-generation,open-source-llms

# Import/extraction API hardening
# Max bytes to fetch from external pages (default 200000)
IMPORT_MAX_BYTES=200000
# Request timeout in milliseconds (default 5000)
IMPORT_TIMEOUT_MS=5000
# Comma-separated allowlist of hostnames for /api/extract
# Example defaults keep it conservative
IMPORT_ALLOW_HOSTS=example.com,www.wikipedia.org,en.wikipedia.org
# Denylist (optional); takes precedence over allow list if present
IMPORT_DENY_HOSTS=

## Notes
# - Do not commit real secrets. Use .env.local for local dev.
# - Firebase Hosting (frameworks backend) should have these configured in its environment as well.
